PORT=3000
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/red-social
JWT_SECRET=cambiar-por-un-secreto-largo
# Cloudinary: Dashboard > API Keys. Forma cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# orígenes permitidos del frontend, separados por coma (vacío permite cualquiera)
FRONTEND_URL=http://localhost:4200
